# Fails when a data file does not match the SHA-256 recorded next to the fixtures.
#   -DDIR=<directory with the files> -DSUMS=<file in sha256sum format>
file(STRINGS "${SUMS}" _lines)
set(_checked 0)
foreach(_line IN LISTS _lines)
  if(NOT _line MATCHES "^([0-9a-f]+)  (.+)$")
    message(FATAL_ERROR "${SUMS}: cannot read the line: ${_line}")
  endif()
  set(_want ${CMAKE_MATCH_1})
  set(_file ${DIR}/${CMAKE_MATCH_2})
  if(NOT EXISTS ${_file})
    message(FATAL_ERROR "${_file} is missing")
  endif()
  file(SHA256 ${_file} _got)
  if(NOT _got STREQUAL _want)
    message(FATAL_ERROR "${_file}: SHA-256 ${_got}, recorded ${_want}")
  endif()
  math(EXPR _checked "${_checked} + 1")
endforeach()
if(_checked EQUAL 0)
  message(FATAL_ERROR "${SUMS} lists no file")
endif()
message(STATUS "${_checked} files match ${SUMS}")
